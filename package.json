{
  "name": "dsh-turn-cost",
  "version": "1.0.0",
  "private": true,
  "description": "Show this turn's DeepSeek API cost next to the token usage under each reply",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "cost", "token-usage"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuFuPie/dsh-turn-cost.git"
  },
  "license": "MIT"
}
